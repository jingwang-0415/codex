@startuml
!pragma layout smetana
title 开发视图：抽象入口继承体系与数据源工厂

top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle

package "metadata-bootstrap" {
  [metadata-api-app] as app
  [metadata-worker-app] as worker
}

package "metadata-entry" {
  component "AbstractMetadataEntry\n<<abstract>>" as baseEntry
  component "GravitinoEntry" as cgrav
  component "IcebergEntry" as cice
  component "InternalEntry" as cint
  baseEntry <|-- cgrav
  baseEntry <|-- cice
  baseEntry <|-- cint
}

package "metadata-core（不依赖具体生态和数据源）" {
  [metadata-domain\n内部模型 / 规则 / 类型] as domain
  [metadata-application\nCommand / Query 用例] as application
  [metadata-mapping\n生态对象 ↔ 内部模型] as mapping
  [metadata-events\n变更事件 / Outbox 契约] as events
}

package "metadata-search" {
  [query-planner] as qplanner
  [index-model\n六类索引文档模型] as indexmodel
  [index-template] as template
  [mapping-governance] as governance
  [index-lifecycle\n别名 / 版本 / 重建] as lifecycle
}

package "metadata-datasource" {
  component "DataSourceFactory" as factory
  component "AbstractDataSource\n<<abstract>>" as baseDS
  component "StarRocksDataSource" as dsSR
  component "IcebergDataSource" as dsIB
  component "OpenSearchDataSource" as dsOS
  factory --> baseDS : create(type, config)
  baseDS <|-- dsSR
  baseDS <|-- dsIB
  baseDS <|-- dsOS
}

app --> baseEntry
baseEntry --> mapping : 统一模板流程
mapping --> application
application --> domain
application --> qplanner
application --> events
application --> factory : 获取读写数据源
worker --> events
worker --> indexmodel
worker --> factory : 获取索引数据源
qplanner --> indexmodel
qplanner --> factory : 回源
indexmodel --> template
template --> governance
governance --> lifecycle

note left of baseEntry
入口扩展规则：
新增生态 = 继承统一抽象类 + 实现差异方法
公共入口逻辑不得在具体入口重复实现
end note

note right of factory
底层扩展规则：
新增数据源 = 实现统一数据源抽象 + 注册到工厂
上层只依赖工厂和抽象类型
end note

note left of domain
依赖方向：入口实现 / 数据源实现 → 抽象与核心
核心不得引用具体生态或具体数据源 SDK
end note
@enduml
