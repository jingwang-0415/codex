@startuml
!pragma layout smetana
title 逻辑视图：统一内部结构驱动索引存储与数据源下放

top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowColor #666666
skinparam ArrowThickness 1.2

package "① 外部接口适配层" as layer1 #F3F6FA {
  together {
    component "Gravitino API" as gravApi
    component "Iceberg Catalog / REST" as iceApi
    component "内部接口" as internalApi
  }

  component "AbstractMetadataEntry\n<<abstract>>\n统一入口契约与公共逻辑" as abstractEntry

  together {
    component "GravitinoEntry" as gravEntry
    component "IcebergEntry" as iceEntry
    component "InternalEntry" as internalEntry
  }

  component "协议对象转换器\nProtocol Mapper" as protocolMapper
  component "统一内部结构\nCanonicalMetadata" as canonical #FFF1F1

  gravApi --> gravEntry
  iceApi --> iceEntry
  internalApi --> internalEntry

  abstractEntry <|-- gravEntry
  abstractEntry <|-- iceEntry
  abstractEntry <|-- internalEntry

  gravEntry --> protocolMapper
  iceEntry --> protocolMapper
  internalEntry --> protocolMapper
  protocolMapper --> canonical : 外部协议对象 → 内部结构
}

package "② OpenSearch 索引分类存储层" as layer2 #FFF8F0 {
  component "IndexClassifier\n按 objectType、查询粒度、更新粒度分类" as classifier
  component "IndexDocumentBuilder\n生成目标索引文档" as docBuilder
  component "OpenSearch Writer\nBulk / Upsert / Delete" as osWriter

  component "Dynamic Template Manager\n产品自定义查询 Key" as templateManager
  component "Mapping Key Governance\n准入 / 类型 / 配额 / 硬上限 / 降级" as mappingGov

  together {
    database "结构导航索引\ncatalog / schema" as navIndexes
    database "核心对象索引\ndataset / table" as coreIndexes
    database "标签索引\ntags / tags-relation" as tagIndexes
  }

  classifier --> docBuilder
  mappingGov --> templateManager
  templateManager --> docBuilder : 受控字段映射
  docBuilder --> osWriter
  osWriter --> navIndexes
  osWriter --> coreIndexes
  osWriter --> tagIndexes
}

package "③ 数据源工厂与下放层" as layer3 #F3FAF5 {
  component "DataSourceType + Config" as sourceConfig
  component "DataSourceFactory\n按数据源类型选择并创建" as factory
  component "AbstractDataSource\n<<abstract>>\n统一数据源操作契约" as abstractDS

  together {
    component "StarRocksDataSource" as sr
    component "IcebergDataSource" as iceberg
    component "OpenSearchDataSource" as opensearch
    component "其他 DataSource" as extension
  }

  sourceConfig --> factory
  factory --> abstractDS : create(type, config)
  abstractDS <|-- sr
  abstractDS <|-- iceberg
  abstractDS <|-- opensearch
  abstractDS <|-- extension
}

layer2 -[hidden]right- layer3

canonical --> classifier : 索引路径\n分类写入 OpenSearch
canonical --> factory : 数据下放路径\n按 sourceType 选择数据源
@enduml
